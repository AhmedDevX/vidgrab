<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light/Dark follow the system DayNight palette with the VidGrab accent. -->
    <style name="Theme.VidGrab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialCardViewStyle">@style/Widget.VidGrab.Card</item>
        <item name="materialButtonStyle">@style/Widget.VidGrab.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.VidGrab.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.VidGrab.Input</item>
    </style>

    <!-- Glass: always-dark violet layered look, visibly distinct from Dark.
         No platform blur is claimed or required; the layering carries it. -->
    <style name="Theme.VidGrab.Glass" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent_dark</item>
        <item name="colorTertiary">@color/accent_dark</item>
        <item name="android:colorBackground">@color/glass_bg</item>
        <item name="colorSurface">@color/glass_surface</item>
        <item name="colorSurfaceVariant">@color/glass_surface_alt</item>
        <item name="colorOnSurface">@color/glass_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/glass_on_surface_sub</item>
        <item name="colorOutline">@color/glass_border</item>
        <item name="android:statusBarColor">@color/glass_bg</item>
        <item name="android:navigationBarColor">@color/glass_bg</item>
        <item name="colorOnPrimary">@color/glass_on_primary</item>
        <item name="materialCardViewStyle">@style/Widget.VidGrab.Card.Glass</item>
        <item name="materialButtonStyle">@style/Widget.VidGrab.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.VidGrab.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.VidGrab.Input</item>
    </style>

    <style name="Widget.VidGrab.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_fill</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.VidGrab.Card.Glass">
        <item name="cardBackgroundColor">@color/glass_card_fill</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
    </style>
    <style name="Widget.VidGrab.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.VidGrab.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.VidGrab.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>
</resources>
