<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light/Dark follow the system DayNight palette with the VidGrab accent. -->
    <style name="Theme.VidGrab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
    </style>

    <!-- Glass: always-dark violet layered look, visibly distinct from Dark.
         No platform blur is claimed or required; the layering carries it. -->
    <style name="Theme.VidGrab.Glass" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent_dark</item>
        <item name="colorTertiary">@color/accent_dark</item>
        <item name="android:colorBackground">@color/glass_bg</item>
        <item name="colorSurface">@color/glass_surface</item>
        <item name="colorSurfaceVariant">@color/glass_surface_alt</item>
        <item name="colorOnSurface">@color/glass_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/glass_on_surface_sub</item>
        <item name="colorOutline">@color/glass_border</item>
        <item name="android:statusBarColor">@color/glass_bg</item>
        <item name="android:navigationBarColor">@color/glass_bg</item>
        <item name="colorOnPrimary">@color/glass_on_primary</item>
    </style>
</resources>
